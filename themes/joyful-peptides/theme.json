{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "background",
					"name": "Paper",
					"color": "#F7F9FB"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#EDF0F3"
				},
				{
					"slug": "ground-tint",
					"name": "Ground Tint",
					"color": "#E4F0FB"
				},
				{
					"slug": "ground-vivid",
					"name": "Ground Glow",
					"color": "#7FC4FC"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#12181F"
				},
				{
					"slug": "ground-ink",
					"name": "Ground Glow (legacy slug, used by block markup)",
					"color": "#7FC4FC"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#4A5A68"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#0B5ED7"
				},
				{
					"slug": "accent-strong",
					"name": "Accent Hover",
					"color": "#0A4EB0"
				},
				{
					"slug": "accent-on-dark",
					"name": "Emphasis On Glow (legacy slug)",
					"color": "#12181F"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				}
			]
		},
		"typography": {
			"lineHeight": true,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Fraunces (Headings)",
					"fontFamily": "\"Fraunces\", ui-serif, Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/fraunces-var.woff2"
							]
						},
						{
							"fontFamily": "Fraunces",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/fraunces-italic-var.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Inter (Body)",
					"fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/inter-var.woff2"
							]
						}
					]
				},
				{
					"slug": "mono",
					"name": "JetBrains Mono (Data)",
					"fontFamily": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "100 800",
							"src": [
								"file:./assets/fonts/jetbrains-mono-var.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "clamp(1rem, 0.96rem + 0.2vw, 1.1rem)"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem)"
				},
				{
					"slug": "x-large",
					"name": "X-Large",
					"size": "clamp(1.9rem, 1.6rem + 1.4vw, 2.7rem)"
				},
				{
					"slug": "xx-large",
					"name": "XX-Large",
					"size": "clamp(2.6rem, 2rem + 3vw, 4.2rem)"
				}
			]
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vh",
				"vw"
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent-strong)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--ink)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "580",
					"lineHeight": "1.1",
					"letterSpacing": "-0.015em"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "999px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "600",
					"letterSpacing": "0.01em"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "var(--wp--preset--color--white)"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"area": "header",
			"title": "Header"
		},
		{
			"name": "footer",
			"area": "footer",
			"title": "Footer"
		}
	]
}
